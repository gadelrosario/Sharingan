index 135ae87..0c98647 100644
--- a/css/app.css
+++ b/css/app.css
@@ -37,6 +37,9 @@ button {
 .hidden {
   display: none !important;
 }
+.resumeDraftCard{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px;margin-bottom:14px;border:1px solid rgba(244,211,94,.5);border-radius:14px;background:rgba(244,211,94,.08)}
+.resumeDraftCard p{margin:4px 0 0}.resumeDraftActions{display:flex;gap:8px;flex-wrap:wrap}.draftTimeline{max-height:280px;overflow:auto;margin-top:10px}.timelineRound{padding:8px 0;border-top:1px solid rgba(255,255,255,.08)}.timelineRound:first-child{border-top:0}.timelineRound>strong{display:block;color:#f4d35e;margin-bottom:5px}.timelinePick{display:grid;grid-template-columns:44px minmax(0,1fr);gap:8px;padding:3px 0;font-size:12px}.timelinePick span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.timelineEmpty{color:var(--muted);font-size:12px}.scrollNotebook textarea{width:100%;min-height:150px;resize:vertical;margin:8px 0;background:#090d14;color:#f7f8fb;border:1px solid rgba(255,255,255,.13);border-radius:10px;padding:11px;font:500 14px/1.45 inherit}.decisionLanes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:10px 0}.decisionLane{padding:9px;border:1px solid rgba(255,255,255,.1);border-radius:10px;background:rgba(255,255,255,.035)}.decisionLane small{display:block;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-size:9px}.decisionLane b{display:block;margin-top:3px;font-size:13px}.decisionScoreGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}.decisionScoreGrid span{padding:7px;border-radius:8px;background:rgba(255,255,255,.04);font-size:10px}.decisionScoreGrid b{display:block;font-size:14px;margin-top:2px}
+@media(max-width:700px){.resumeDraftCard{align-items:stretch;flex-direction:column}.resumeDraftActions>*{flex:1}.decisionLanes{grid-template-columns:1fr}.decisionScoreGrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
 header {
   position: sticky;
   top: 0;
