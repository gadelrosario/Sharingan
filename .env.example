# Yahoo OAuth credentials are server-side only. Never expose these values to browser JavaScript.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:8787/api/yahoo/callback
YAHOO_APP_URL=http://127.0.0.1:8000/
YAHOO_ALLOWED_ORIGIN=http://127.0.0.1:8000
YAHOO_TLS_CERT_FILE=.certs/yahoo-localhost.pem
YAHOO_TLS_KEY_FILE=.certs/yahoo-localhost-key.pem
# Keep the real token store outside the repository.
YAHOO_TOKEN_STORE=
